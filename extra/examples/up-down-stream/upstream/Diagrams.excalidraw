      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "I9567GLXq3EG-I8MIGLT9",
      "type": "text",
      "x": 96.47696977525663,
      "y": 1365.12534304074,
      "width": 223.81980895996094,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8j",
      "roundness": null,
      "seed": 830602530,
      "version": 283,
      "versionNonce": 325434978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734457861294,
      "link": null,
      "locked": false,
      "text": "'handle' is an arbitrary \nname chosen for this \ndiagram as it is the \napplication that must \nimplements \nAppClientExHandler. \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "'handle' is an arbitrary \nname chosen for this \ndiagram as it is the \napplication that must \nimplements \nAppClientExHandler. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "n5aJ_fll-Gs64nPnLEymq",
      "type": "text",
      "x": 443.60089819210526,
      "y": 1542.2283446757367,
      "width": 498.4394836425781,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8k",
      "roundness": null,
      "seed": 2016143998,
      "version": 675,
      "versionNonce": 2143946850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734457751074,
      "link": null,
      "locked": false,
      "text": "A typical implementation of \nthe 'handle' method is to \ncall the \nbuildRequestErrorResponse \nof the parent class that converts \nthe exception in the ClientRequestErrorException \nhierarchy in a RequestErrorResponse and return it.\nThe REST abstraction of Spring allow to ease \nsuch an implementation.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A typical implementation of \nthe 'handle' method is to \ncall the \nbuildRequestErrorResponse \nof the parent class that converts \nthe exception in the ClientRequestErrorException \nhierarchy in a RequestErrorResponse and return it.\nThe REST abstraction of Spring allow to ease \nsuch an implementation.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
