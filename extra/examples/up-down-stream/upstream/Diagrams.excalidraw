    },
    {
      "id": "FwWEepMftzznHDhD5GqnR",
      "type": "text",
      "x": 95.72690324402788,
      "y": 2274.7126832173485,
      "width": 223.81980895996094,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9K",
      "roundness": null,
      "seed": 1324761342,
      "version": 346,
      "versionNonce": 845826494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734458041834,
      "link": null,
      "locked": false,
      "text": "'handle' is an arbitrary \nname chosen for this \ndiagram as it is the \napplication that must \nimplements \nAppServerExHandler. \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "'handle' is an arbitrary \nname chosen for this \ndiagram as it is the \napplication that must \nimplements \nAppServerExHandler. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cJFZ0lLq3qtP6efwx4mqw",
      "type": "text",
      "x": 442.85083166087645,
      "y": 2451.815684852345,
      "width": 501.8594970703125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9L",
      "roundness": null,
      "seed": 1656844606,
      "version": 738,
      "versionNonce": 1802914018,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734458033005,
      "link": null,
      "locked": false,
      "text": "A typical implementation of \nthe 'handle' method is to \ncall the \nbuildRequestErrorResponse \nof the parent class that converts \nthe exception in the ServerRequestErrorException \nhierarchy in a RequestErrorResponse and return it.\nThe REST abstraction of Spring allow to ease \nsuch an implementation.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A typical implementation of \nthe 'handle' method is to \ncall the \nbuildRequestErrorResponse \nof the parent class that converts \nthe exception in the ServerRequestErrorException \nhierarchy in a RequestErrorResponse and return it.\nThe REST abstraction of Spring allow to ease \nsuch an implementation.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
